# Security headers for the static site. Guarded so a server without mod_headers keeps working.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

# Never serve dotfiles such as .env.example.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# Every page is a prerendered folder with its own index.html. An unknown address gets
# a real 404 status, so search engines never index an empty page as a duplicate home.
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_alias.c>
  Redirect 301 /participantes /vencedores/
  Redirect 301 /categorias /regulamento/
  # Temporary while the 2027 Programação page is switched off (see src/App.jsx).
  Redirect 302 /programacao /
  Redirect 302 /finalistas /
</IfModule>

# Built files carry a content hash in their name, so they can be cached for a year.
# Pages are revalidated on every visit so a new deploy shows at once.
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>
